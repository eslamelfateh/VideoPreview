# Required when the server is reachable from the network (Docker / cloud).
LIVECUT_TOKEN=change-me-to-a-long-random-string

# Where the server is reachable, used for export download links.
# PUBLIC_URL=https://livecut.example.com

# Speech-to-text: any OpenAI-compatible /audio/transcriptions endpoint with word timestamps.
# TRANSCRIBE_API_KEY=sk-...
# TRANSCRIBE_BASE_URL=https://api.openai.com/v1        # or https://api.groq.com/openai/v1
# TRANSCRIBE_MODEL=whisper-1                            # or whisper-large-v3 on Groq

# How long an agent waits on a paused/reviewed step before it is told to call wait_for_user (ms).
# LIVECUT_WAIT_MS=240000
